ok  title extracted => "T"
ok  body after title => "\nbody\n"
ok  no title when not a heading => nil
ok  leading blank lines skipped => "T"
ok  hash without space is not a title => nil
ok  paragraph => "<p>Hello.</p>\n"
ok  leading blank line kept => "\n<p>Hello.</p>\n"
ok  two paragraphs => "<p>One.</p>\n\n<p>Two.</p>\n"
ok  a newline in a paragraph is a line break => "<p>a<br />\nb</p>\n"
ok  a newline in a code span is not => "<p><code>a\nb</code></p>\n"
ok  empty input => ""
ok  heading with id => "<h4 id=\"the-workaround\">The workaround</h4>\n"
ok  heading id keeps underscores => "<h2 id=\"snake_case-heading\">snake_case heading</h2>\n"
ok  heading id keeps leading digits => "<h2 id=\"10-years-later\">10 years later</h2>\n"
ok  heading id drops punctuation => "<h2 id=\"whats-wrong\">What\\u2019s wrong?</h2>\n"
ok  duplicate heading ids are numbered => "<h2 id=\"same\">Same</h2>\n\n<h2 id=\"same-1\">Same</h2>\n\n<h2 id=\"same-2\">Same</h2>\n"
ok  heading with no id-able text => "<h2>!!!</h2>\n"
ok  underlined with equals is an h1 => "<h1 id=\"title\">Title</h1>\n"
ok  underlined with dashes is an h2 => "<h2 id=\"title\">Title</h2>\n"
ok  one underline character is enough => "<h1 id=\"title\">Title</h1>\n"
ok  the first underline character picks the level => "<h1 id=\"title\">Title</h1>\n"
ok  markup in an underlined heading => "<h1 id=\"title\"><em>Title</em></h1>\n"
ok  a second line is not underlined => "<p>One<br />\nTwo<br />\n===</p>\n"
ok  an indented underline is not one => "<p>Title<br />\n  \\u2014</p>\n"
ok  an underline with nothing over it is text => "\n<p>===</p>\n"
ok  horizontal rule => "<p>a</p>\n\n<hr />\n\n<p>b</p>\n"
ok  unordered list => "<ul>\n  <li>one</li>\n  <li>two</li>\n</ul>\n"
ok  ordered list => "<ol>\n  <li>one</li>\n  <li>two</li>\n</ol>\n"
ok  blockquote => "<blockquote>\n  <p>quoted<br />\nmore</p>\n</blockquote>\n"
ok  inline code => "<p>a <code>c</code> b</p>\n"
ok  code span is literal => "<p>a <code>x &lt; y &amp; z</code> b</p>\n"
ok  double backticks => "<p>use <code>a ` b</code> here</p>\n"
ok  strong => "<p>a <strong>b</strong> c</p>\n"
ok  em with star => "<p>a <em>b</em> c</p>\n"
ok  em with underscore => "<p>a <em>b</em> c</p>\n"
ok  intraword underscores untouched => "<p>ID_ATA_FEATURE_SET_APM=1</p>\n"
ok  absolute link gets nofollow => "<p><a href=\"https://example.com\" rel=\"nofollow\">out</a></p>\n"
ok  relative link left alone => "<p><a href=\"other.html\">in</a></p>\n"
ok  parens in a url are balanced, not cut at the first one => "<p><a href=\"https://en.wikipedia.org/wiki/Ruby_(programming_language)\" rel=\"nofollow\">Ruby</a></p>\n"
ok  an unbalanced destination is literal text => "<p>[x](a(b)</p>\n"
ok  a run of unclosed brackets is literal text => "<p>[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[</p>\n"
ok  a javascript url is not a link => "<p>[click](javascript:alert(1))</p>\n"
ok  nor in any casing => "<p>[click](JaVaScRiPt:alert(1))</p>\n"
ok  nor with a tab hiding in it => "<p>[click](java\tscript:alert(1))</p>\n"
ok  a data url is not a link => "<p>[x](data:text/html,hi)</p>\n"
ok  nor an image source => "<p>![i](javascript:alert(1))</p>\n"
ok  mailto is fine => "<p><a href=\"mailto:a@b.c\">mail</a></p>\n"
ok  a relative url has no scheme to check => "<p><a href=\"../a.html\">up</a></p>\n"
ok  an anchor has none either => "<p><a href=\"#x\">here</a></p>\n"
ok  a title is its own attribute => "<p><a href=\"u\" title=\"t\">x</a></p>\n"
ok  a single-quoted title too => "<p><a href=\"u\" title=\"t\">x</a></p>\n"
ok  a quote in an attribute cannot end it => "<p><a href=\"u\" title=\"it&#39;s\">a</a></p>\n"
ok  a quote in text becomes typographic => "<p>plain \\u2018quotes\\u2019 stay</p>\n"
ok  image => "<p><img src=\"pic.png\" alt=\"alt\" /></p>\n"
ok  image with an empty alt => "<p><img src=\"pic.png\" alt=\"\" /></p>\n"
ok  image alt is literal, not markup => "<p><img src=\"pic.png\" alt=\"a *b*\" /></p>\n"
ok  image alt is escaped => "<p><img src=\"p.png\" alt=\"a &quot;b&quot; &amp; c\" /></p>\n"
ok  image with a title => "<p><img src=\"p.png\" alt=\"a\" title=\"t\" /></p>\n"
ok  image inside a link => "<p><a href=\"http://x\" rel=\"nofollow\"><img src=\"p.png\" alt=\"a\" /></a></p>\n"
ok  an image gets no nofollow => "<p><img src=\"https://ex.com/p.png\" alt=\"a\" /></p>\n"
ok  a bang that starts no image is literal => "<p>!not an image</p>\n"
ok  a bang before a link is literal => "<p>!<img src=\"p.png\" alt=\"a\" /></p>\n"
ok  bare bracket is literal => "<p>[1] a footnote marker</p>\n"
ok  typographic quotes => "<p>It\\u2019s a \\u201Cquote\\u201D</p>\n"
ok  a quote in a code span stays straight => "<p><code>it's</code></p>\n"
ok  dashes and ellipsis => "<p>a \\u2013 b \\u2014 c \\u2026 d</p>\n"
ok  a decade abbreviation closes => "<p>the \\u201980s</p>\n"
ok  nested quotes => "<p>he said \\u201C\\u2018quoted\\u2019 words\\u201D</p>\n"
ok  markup characters escaped => "<p>5 &lt; 6 &amp; 7 &gt; 4</p>\n"
ok  a tag is text => "<p>a &lt;b&gt;bold&lt;/b&gt; c</p>\n"
ok  a script tag is text => "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n"
ok  an event handler is text => "<p>&lt;img src=x onerror=alert(1)&gt;</p>\n"
ok  a closing tag is text => "<p>a &lt;/b&gt; c</p>\n"
ok  a comment is text => "<p>a &lt;!\u2013 hi \u2013&gt; b</p>\n"
ok  a block level element is text, not a block => "<p>text</p>\n\n<p>&lt;div&gt;x&lt;/div&gt;</p>\n\n<p>text</p>\n"
ok  markdown inside a tag is still markdown => "<p>a &lt;b&gt;<em>it</em>&lt;/b&gt; b</p>\n"
ok  lt that is not a tag is text too => "<p>5 &lt; 6 and a &lt;3 b</p>\n"
ok  a tag inside a code span is escaped once => "<p>use <code>&lt;b&gt;</code> here</p>\n"
ok  a named entity is text => "<p>AT&amp;T &amp;amp; co</p>\n"
ok  a numeric entity is text => "<p>a &amp;#x41; b</p>\n"
ok  a typographic entity is text => "<p>a &amp;mdash; b</p>\n"
ok  a bare ampersand is escaped once => "<p>Ben &amp; Jerry</p>\n"
