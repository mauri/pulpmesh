<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title><%= h config.title %></title>
    <link><%= h url_for %></link>
    <description><%= h config.description %></description>
    <language>en</language>
    <atom:link href="<%= h url_for("rss.xml") %>" rel="self" type="application/rss+xml" />
    <% posts.each do |entry| -%>
    <item>
      <title><%= h entry.title %></title>
      <link><%= h post_url(entry) %></link>
      <guid isPermaLink="true"><%= h post_url(entry) %></guid>
      <pubDate><%= rfc822 entry.date %></pubDate>
      <% entry.tags.each do |tag| -%>
      <category><%= h tag %></category>
      <% end -%>
      <description><%= cdata entry.html %></description>
    </item>
    <% end -%>
  </channel>
</rss>
